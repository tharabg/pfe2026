# ── Sécurité JWT ──────────────────────────────────────────────────────────────
# Générer une vraie clé : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGEZ_MOI_EN_PRODUCTION
JWT_EXPIRE_MINUTES=480

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=topnet_ocr
DB_USER=postgres
DB_PASSWORD=postgres

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Models
DOCUMENT_CLASSIFIER_MODEL=efficientnet_b0
OCR_MODEL=paddle
VLM_MODEL=openai/clip-vit-base-patch32
LLM_MODEL=mistral

# MLOps
MLFLOW_TRACKING_URI=file:./mlruns
DVC_REMOTE=

# Languages
SUPPORTED_LANGUAGES=en,ar,fr
